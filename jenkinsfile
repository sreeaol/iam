pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Init') {
            steps {
                // 'gcp-sa-key' = Jenkins "Secret file" credential holding the service account JSON key
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    sh 'terraform init -input=false'
                }
            }
        }

        stage('Validate') {
            steps {
                sh 'terraform fmt -check && terraform validate'
            }
        }

        stage('Plan') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    sh 'terraform plan -input=false -var-file=terraform.tfvars -out=tfplan'
                }
            }
        }

        stage('Approval') {
            when { expression { params.ACTION != 'plan' } }
            steps {
                input message: "Proceed with terraform ${params.ACTION}?"
            }
        }

        stage('Apply / Destroy') {
            when { expression { params.ACTION != 'plan' } }
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    script {
                        if (params.ACTION == 'apply') {
                            sh 'terraform apply -input=false tfplan'
                        } else {
                            sh 'terraform destroy -input=false -var-file=terraform.tfvars -auto-approve'
                        }
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
    }
}
