pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action')
        string(name: 'PROJECT_ID', defaultValue: 'project-135912bf-7758-481f-965', description: 'GCP project ID')
        string(name: 'REGION', defaultValue: 'asia-south1', description: 'GCP region')
        string(name: 'VIEWER_MEMBERS', defaultValue: '', description: 'Comma-separated viewers, e.g. user:alice@example.com,group:devs@example.com (optional)')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Set Terraform variables') {
            steps {
                script {
                    if (!params.PROJECT_ID?.trim()) {
                        error('PROJECT_ID parameter is required')
                    }
                    // Convert "a,b" into an HCL list: ["a","b"]
                    def members = params.VIEWER_MEMBERS.split(',')
                        .collect { it.trim() }
                        .findAll { it }
                        .collect { "\"${it}\"" }
                        .join(',')
                    env.TF_VAR_project_id = params.PROJECT_ID.trim()
                    env.TF_VAR_region = params.REGION.trim()
                    env.TF_VAR_viewer_members = "[${members}]"
                }
            }
        }

        stage('Init') {
            steps {
                // 'gcp-sa-key' = Jenkins "Secret file" credential holding the service account JSON key
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    sh 'terraform init -input=false'
                }
            }
        }

        stage('Validate') {
            steps {
                sh 'terraform fmt -check && terraform validate'
            }
        }

        stage('Plan') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    sh 'terraform plan -input=false -out=tfplan'
                }
            }
        }

        stage('Approval') {
            when { expression { params.ACTION != 'plan' } }
            steps {
                input message: "Proceed with terraform ${params.ACTION} on project ${params.PROJECT_ID}?"
            }
        }

        stage('Apply / Destroy') {
            when { expression { params.ACTION != 'plan' } }
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    script {
                        if (params.ACTION == 'apply') {
                            sh 'terraform apply -input=false tfplan'
                        } else {
                            sh 'terraform destroy -input=false -auto-approve'
                        }
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
    }
}
